+++ b/crates/media-bridge/src/audio/stereo.rs
@@ -0,0 +1,117 @@
+use rustfft::{num_complex::Complex32, Fft, FftPlanner};
+use std::sync::Arc;
+
+pub(crate) const BANDS: usize = 64;
+
+#[derive(Clone)]
+pub(crate) struct StereoFrame {
+    pub(crate) sample_end: u64,
+    pub(crate) sample_rate: u32,
+    pub(crate) bands: [f32; BANDS * 2],
+}
+
+pub(crate) struct Analyzer {
+    sample_rate: u32,
+    rate: u32,
+    phase: u32,
+    ring: Vec<[f32; 2]>,
+    cursor: usize,
+    filled: usize,
+    fft: Arc<dyn Fft<f32>>,
+    scratch: Vec<Complex32>,
+    bins: Vec<Complex32>,
+    map: Vec<(usize, f32)>,
+}
+
+impl Analyzer {
+    pub(crate) fn new(sample_rate: u32, rate: u32) -> Self {
+        let length = (1920 * u64::from(sample_rate.max(44100)) / 44100) as usize;
+        let fft = FftPlanner::new().plan_fft_forward(length);
+        let scratch = vec![Complex32::default(); fft.get_inplace_scratch_len()];
+        let mut previous = 0;
+        let map = (0..639.min(length / 2 - 1))
+            .map(|index| {
+                let fraction = index as f32 / 639.;
+                let nominal = (fraction.sqrt().sqrt() * BANDS as f32) as usize;
+                previous = nominal.min(previous + 1).min(BANDS - 1);
+                let weight = (0.501 - 0.499 * (std::f32::consts::PI * fraction).cos()).sqrt();
+                (previous, weight)
+            })
+            .collect();
+        Self {
+            sample_rate,
+            rate,
+            phase: 0,
+            ring: vec![[0.; 2]; length],
+            cursor: 0,
+            filled: 0,
+            fft,
+            scratch,
+            bins: vec![Complex32::default(); length],
+            map,
+        }
+    }
+
+    pub(crate) fn reset(&mut self) {
+        self.phase = 0;
+        self.cursor = 0;
+        self.filled = 0;
+    }
+
+    pub(crate) fn push(&mut self, sample: [f32; 2], sample_end: u64) -> Option<StereoFrame> {
+        let length = self.ring.len();
+        self.ring[self.cursor] = sample;
+        self.cursor = (self.cursor + 1) % length;
+        self.filled = (self.filled + 1).min(length);
+        self.phase += self.rate;
+        if self.phase < self.sample_rate {
+            return None;
+        }
+        self.phase -= self.sample_rate;
+        if self.filled < length {
+            return None;
+        }
+        let mut bands = [0.; BANDS * 2];
+        for channel in 0..2 {
+            for (bin, pair) in self.bins.iter_mut().zip(self.ring[self.cursor..].iter().chain(&self.ring[..self.cursor])) {
+                *bin = Complex32::new(pair[channel], 0.);
+            }
+            self.fft.process_with_scratch(&mut self.bins, &mut self.scratch);
+            let scale = 162.56 / length as f32;
+            for ((band, weight), bin) in self.map.iter().copied().zip(&self.bins[1..]) {
+                let position = channel * BANDS + band;
+                bands[position] = f32::max(bands[position], bin.norm() * weight * scale);
+            }
+        }
+        Some(StereoFrame { sample_end, sample_rate: self.sample_rate, bands })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn stereo_and_all_rates_follow_samples() {
+        for rate in [10, 20, 30, 60, 90, 120] {
+            let mut analyzer = Analyzer::new(44100, rate);
+            let mut previous = None;
+            let mut frames = 0;
+            for sample in 1..=88200 {
+                let amplitude = (sample as f32 * std::f32::consts::TAU * 440. / 44100.).sin() * 0.1;
+                if let Some(frame) = analyzer.push([amplitude, 0.], sample) {
+                    assert!(frame.bands[..BANDS].iter().any(|x| *x > 0.01));
+                    assert!(frame.bands[BANDS..].iter().all(|x| *x == 0.));
+                    if let Some(last) = previous {
+                        let hop = frame.sample_end - last;
+                        assert!((44100 / rate..=44100u32.div_ceil(rate)).contains(&(hop as u32)));
+                    }
+                    previous = Some(frame.sample_end);
+                    frames += u32::from(sample > 44100);
+                }
+            }
+            assert_eq!(frames, rate);
+        }
+    }
+}
+
